# ---------------------------------------------------------------------------
# Copy to `.env.local` for development, or set these in the Vercel dashboard.
# Never commit real credentials — `.env*.local` is gitignored.
# ---------------------------------------------------------------------------

# Canonical origin. Drives canonical URLs, Open Graph tags, JSON-LD and the
# sitemap. Must include the protocol and no trailing slash.
NEXT_PUBLIC_SITE_URL="https://www.alaknandaship.com"

# --- SMTP (form delivery) --------------------------------------------------
# Without these the enquiry, careers and newsletter forms still succeed, but
# submissions are logged to the server console instead of emailed. Configure
# before going live.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="info@alaknandaship.com"
SMTP_PASSWORD=""
SMTP_FROM="\"Alaknanda Ship Management\" <info@alaknandaship.com>"

# Where form submissions are delivered. Defaults to contactInfo.email.
ENQUIRY_RECIPIENT="info@alaknandaship.com"

# --- Analytics (optional) --------------------------------------------------
# Each tag renders only when its variable is set, so leaving these blank keeps
# development and preview deploys free of third-party requests.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# --- Search Console --------------------------------------------------------
# The content value from the Google Search Console HTML-tag verification method.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
